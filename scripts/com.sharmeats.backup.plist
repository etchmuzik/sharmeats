<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily off-site backup of the Sharm Eats production database.

  The project is on the Supabase free plan, which has no managed backups and no
  PITR, so this scheduled job is the only thing producing a restorable copy.

  The database password is NOT in this file — backup-prod.sh reads it from the
  macOS Keychain item "sharmeats-db-password".

  Install:
    cp scripts/com.sharmeats.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.sharmeats.backup.plist

  Run once now (don't wait for 03:00):
    launchctl start com.sharmeats.backup

  Check it:
    launchctl list | grep sharmeats
    tail -20 ~/sharmeats-backups/backup.log

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.sharmeats.backup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sharmeats.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/etch/Downloads/sharmeats-new/scripts/backup-prod.sh</string>
  </array>

  <!-- 03:00 local time, daily. RunAtLoad is deliberately false so installing
       this at midday doesn't fire an immediate dump; use `launchctl start`.

       StartCalendarInterval ALREADY handles the asleep-at-03:00 case on its
       own: launchd(8) states "Unlike cron which skips job invocations when the
       computer is asleep, launchd will start the job the next time the computer
       wakes up... multiple intervals... coalesced into one event upon wake".
       So no catch-up key is needed. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>

  <!-- DELIBERATELY NO StartInterval. An earlier version paired
       StartInterval=86400 with the calendar interval above, commented as a
       catch-up for a sleeping Mac. That is backwards on both counts:
         · StartCalendarInterval is the key that survives sleep (quoted above);
           StartInterval is the one that MISSES firings during sleep
           ("that interval will be missed due to shortcomings in kqueue(3)");
         · the two are evaluated INDEPENDENTLY, per launchd.plist(5): "Note that
           StartInterval and StartCalendarInterval are not aware of each other."
       Together they produced TWO schedules: 03:00 daily, plus another every 24h
       counted from whenever the agent was last loaded. Each extra run is a full
       ~2 MB dump of every customer row. Removed. -->

  <key>WorkingDirectory</key>
  <string>/Users/etch/Downloads/sharmeats-new</string>

  <!-- Homebrew paths for pg_dump/supabase; launchd's default PATH is minimal.

       OFF-SITE MIRROR: add MIRROR_DIR below, pointing at the external drive,
       and every backup is duplicated there automatically after it verifies.
       Find the exact path with `ls /Volumes` while the drive is attached —
       macOS mounts by volume NAME, so a drive called "Backups" is
       /Volumes/Backups, and a space in the name is a real character.

         <key>MIRROR_DIR</key>
         <string>/Volumes/YOUR_DRIVE_NAME/sharmeats-backups</string>

       It mirrors rather than relocates: the laptop copy stays authoritative
       and either copy alone is a complete restore point. An unplugged drive
       warns and does NOT fail the dump, but check-backup-freshness.sh treats a
       configured-yet-stale mirror as unhealthy — so leaving it unplugged for a
       day is visible instead of silent.

       Re-load the agent after editing:
         launchctl unload ~/Library/LaunchAgents/com.sharmeats.backup.plist
         cp scripts/com.sharmeats.backup.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.sharmeats.backup.plist -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Both streams to one log so a failure is visible rather than silent. -->
  <key>StandardOutPath</key>
  <string>/Users/etch/sharmeats-backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/etch/sharmeats-backups/backup.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
