expo-env.d.ts
# Expo prebuild output — generated from app.json, not committed
/apps/*/ios/
/apps/*/android/
.previews/
.maestro/artifacts/
# Supabase CLI scratch
supabase/.temp/
# Build artifacts — signed binaries and deploy bundles must never be committed
# (a stray `git add -A` would otherwise commit a ~16MB signed .ipa). Build them
# locally / in CI and upload via Transporter/EAS/Play, don't track them.
*.ipa
*.aab
*.apk
*-deploy.zip
# Any build/export zip (e.g. landing/sharmeatslanding_*.zip) — never commit to
# this public repo. The narrower *-deploy.zip above missed timestamped exports.
*.zip
# Local design-tool scratch: multi-MB mockups + licensed stock photos, not source.
new style/
"new style/"

# Signing / store credentials — NEVER commit. ASC API keys (.p8), Google Play
# service-account JSONs, and anything under a per-app credentials/ dir are secrets.
# EAS reads them from disk at submit time; they live locally / in EAS, not in git.
**/credentials/
*.p8
*service-account*.json
# Firebase names its downloaded service-account key "<project>-firebase-adminsdk-<id>.json"
# — no "service-account" in the name, so the pattern above does NOT catch it. It
# is the FCM signing key: with it anyone can push notifications as this app.
*firebase-adminsdk*.json

# Firebase Android config, needed at build time for FCM push. Google does not
# class this as a secret, but this repository is PUBLIC and the file carries the
# project number and an API key — publishing them invites nuisance abuse of the
# FCM quota for no benefit. Supplied to builds as the file-type EAS environment
# variable GOOGLE_SERVICES_JSON instead; see docs/ANDROID-PUSH-FCM.md.
# The * covers browser-renamed duplicates: "google-services (1).json" etc. —
# the exact-name pattern alone left those trackable.
google-services*.json
GoogleService-Info.plist

.superpowers/
__pycache__/
*.pyc

# Agent-session debris (screenshots, page snapshots) — never commit.
output/
.playwright-cli/
deploy-zips/

# Local database backups — contain full customer data, never commit.
sharmeats-backups/
*.dump

# Build-time release manifests (scripts/write-version-manifest.mjs).
# Generated into the artifact, never committed: a checked-in version.json would
# dirty the tree on every build, which then fails the script's own strict check.
landing/public/version.json
apps/*/public/version.json
