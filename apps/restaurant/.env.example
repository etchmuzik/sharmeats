# Sharm Eats — restaurant app environment
# Copy to .env and fill in. NEVER commit .env.
#
# For EAS builds these are set in eas.json build profiles / EAS secrets,
# not from this file — this file is for local `npm start` development.

# Supabase project (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Crash reporting (optional locally; set in the EAS production profile for builds)
EXPO_PUBLIC_SENTRY_DSN=

# Workaround toggle: use React Native fetch instead of the default (leave unset
# unless debugging network issues on device)
EXPO_PUBLIC_USE_RN_FETCH=
