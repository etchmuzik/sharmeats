{
  "name": "sharmeats-admin-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "prebuild": "node ../../scripts/write-version-manifest.mjs --surface admin-web",
    "build": "next build",
    "build:export": "STATIC_EXPORT=1 next build && npm run sentry:sourcemaps",
    "sentry:sourcemaps": "node ../../scripts/finalize-web-sourcemaps.mjs --dir out",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
